[0.001, "o", "Optional dependencies for python-gobject\r\n\u001b[0;1m   \u001b[0m python-cairo: Cairo bindings\r\n"]
[0.001, "o", "(192/195) installing python-firewall                                                                                                             [----------------------------------------------------------------------------------------]   0%\r"]
[0.013, "o", "(192/195) installing python-firewall                                                                                                             [########################################################################################] 100%\r\r\n(193/195) installing python-capng                                                                                                                [----------------------------------------------------------------------------------------]   0%\r(193/195) installing python-capng                                                                                                                [########################################################################################] 100%\r\r\n"]
[0.002, "o", "(194/195) installing firewalld                                                                                                                   [----------------------------------------------------------------------------------------]   0%\r"]
[0.011, "o", "(194/195) installing firewalld                                                                                                                   [########################################################################################] 100%\r\r\n"]
[0.058, "o", "\r\n:: The firewallD components & utilities have now been split into different packages:\r\n\r\n   - firewalld: Firewall daemon with D-Bus interface \r\n"]
[0.000, "o", "   - python-firewall: Python bindings for firewallD\r\n"]
[0.003, "o", "   - firewall-config: Graphical user interface for firewallD\r\n   - firewall-applet: Systray applet for firewallD\r\n   - firewalld-test: FirewallD test suite\r\n\r\n   Make sure to install the ones you may want / need.\r\n\r\nOptional dependencies for firewalld\r\n\u001b[0;1m   \u001b[0m bash-completion: bash completion\r\n    networkmanager: NetworkManager support\r\n    polkit: privileged actions\r\n    firewall-config: Graphical user interface for firewallD configuration\r\n    firewall-applet: Systray applet for firewallD\r\n    firewalld-test: firewallD test suite\r\n(195/195) installing lynis                                                                                                                       [----------------------------------------------------------------------------------------]   0%\r"]
[0.006, "o", "(195/195) installing lynis                                                                                                                       [########################################################################################] 100%\r\r\nOptional dependencies for lynis\r\n\u001b[0;1m   \u001b[0m net-tools: networking tests\r\n    bind-tools: nameserver tests\r\n    iptables: firewall tests [installed]\r\n"]
