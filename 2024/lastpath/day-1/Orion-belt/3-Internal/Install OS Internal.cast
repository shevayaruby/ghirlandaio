[0.011, "o", "\u001b[?25l\u001b[67;230H  \r\u001b[67;1H\u001b[17X:\u001b[H\u001b[16X\u001b[2;3HBINARIES\u001b[3;5His setting includes any additional binaries a given user may\u001b[4;3Hwish into the CPIO image.  This is run last, so it may be used to\u001b[5;3Hoverride the actual binaries included by a given hook\u001b[6;3HBINARIES are dependency parsed, so you may safely ignore libraries\r\nBINARIES=()\u001b[9;3HFILES   \u001b[10;17Hs similar to BINARIES above, however, files are added\u001b[11;3Has-is and are not parsed in any way.  This is useful for config files.\r\nFILES=()\u001b[47X\r\n\u001b[68X\n# HOOKS    \r\n# This is the most important setting in this file.  The HOOKS control the\u001b[16;3Hmodules and scripts added to the image, and what happens at boot time.\u001b[17;3HOrder is important, and it is recommended that you do not change the\u001b[18;3Horder in which HOOKS are added.  Run 'mkinitcpio -H <hook name>' for  \r\n# help on a given hook.\r\n# 'base' is _required_ unless you know precisely what you are doing.\u001b[21;3H'udev' is _required_ in order to automatically load modules\u001b[22;3H'filesystems' is _required_ unless you specify your fs modules in MODULES\u001b[23;3HExamples:\u001b[61X\u001b[24;2H#   This setup specifies all modules in the MODULES setting above.   \u001b[25;2H#   No RAID, lvm2, or encrypted root is needed.\u001b[22X\u001b[26;3H   HOOKS=(base)\u001b[6X\u001b[27;2H\u001b[67X\n#   This setup will autodetect all modules for your system and should\u001b[29;2H#   work as a sane default\u001b[48X\u001b[30;3H   HOOKS=(base udev autodetect microcode modconf block filesystems fsck)\u001b[31;2H\u001b[66X\u001b[32;6HThis setup will generate a 'full' image which supports most systems.\u001b[33;2H#   No autodetection is done.\u001b[34;2H    HOOKS=(base udev microcode modconf block filesystems fsck)\u001b[35;2H\u001b[69X\u001b[36;6HThis setup assembles a mdadm array with an encrypted root file system.\u001b[37;2H#   Note: See 'mkinitcpio -H mdadm_udev' for more information on RAID devices.\u001b[38;2H    HOOKS=(base udev microcode modconf keyboard keymap consolefont block mdadm_udev encrypt filesystems fsck)\u001b[39;2H\u001b[72X\u001b[40;6HThis setup loads an lvm2 volume group.\u001b[41;47Hlvm2 filesystems fsck)\u001b[43;11Hwill create a systemd based initramfs which loads an encrypted root filesystem.\u001b[44;2H    HOOKS=(base systemd autodetect microcode modconf kms keyboard sd-vconsole block sd-encrypt filesystems fsck)\u001b[45;2H\u001b[109X\n#   NOTE: If you have /usr on a separate partition, you MUST include the\u001b[47;2H    usr and fsck hooks.\u001b[19X\r\nHOOKS=(base systemd autodetect microcode modconf kms keyboard sd-vconsole block sd-encrypt lvm2 filesystems fsck)\r\n \n COMPRESSION\u001b[76X\u001b[51;3HUse this to compress the initramfs image. By default, zstd compression\u001b[41X\u001b[52;2H is used for Linux ≥\u001b[52;22H 5.9 and gzip compression is used for Linux < 5.9.\u001b[53;2H Use 'cat' to create an uncompressed image.\u001b[29X\u001b[54;2HCOMPRESSION=\"zstd\"\u001b[5X\r\n#COMPRESSION=\"gzip\"\u001b[94X\r\n#COMPRESSION=\"bzip2\"\u001b[57;2HCOMPRESSION=\"lzma\"\r\n\u001b[0;10;4;1m\u000fetc/mkinitcpio.conf [+]                                                                                                                                                                                                       55,92          29%\r\n\u001b[m\u000f:\u001b[0;10;1m\u000fwq\u001b[m\u000f\u001b[68X\r\n:\u001b[0;10;1m\u000fq\u001b[m\u000f!\u001b[41X\r\n:\u001b[18X\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n\u001b[0;10;7m\u000f[Command Line]                                                                                                                                                                                                                3,0-1          All\u001b[2 q\u001b[61;2H\u001b[?25h"]
[2.299, "o", "\u001b[?25l\u001b[67;230H\u001b[m\u000f:\u001b[61;2H\u001b[?25h"]
[0.001, "o", "\u001b[?25l\r\u001b[6B\u001b[230X:\u001b[2 q\u001b[?1002l\u001b[?1006l\u001b[?25h"]
[0.703, "o", "\u001b[?25lq\u001b[?25h"]
[0.481, "o", "\u001b[?25l!\u001b[?25h"]
[0.563, "o", "\u001b[?25l\r\u001b[67;1H\u001b[?25h"]
[0.006, "o", "\u001b[?25l   \u001b[H# vim:set ft=sh:\u001b[2;3HMODULES \u001b[3;5He following modules are loaded before any boot hooks are    \u001b[4;3Hrun.  Advanced users may wish to specify all system modules\u001b[6X\u001b[5;3Hin this array.  For instance:\u001b[24X\u001b[6;3H    MODULES=(usbhid xhci_hcd)\u001b[37X\r\nMODULES=() \u001b[9;3HBINARIES\u001b[10;17Hncludes any additional binaries a given user may\u001b[5X\u001b[11;3Hwish into the CPIO image.  This is run last, so it may be used to\u001b[5X\r\n# override the actual binaries included by a given hook\r\n# BINARIES are dependency parsed, so you may safely ignore libraries\r\nBINARIES=()\r\n\u001b[73X\u001b[16;3HFILES\u001b[65X\u001b[17;3HThis setting is similar to BINARIES above, however, files are added \u001b[18;3Has-is and are not parsed in any way.  This is useful for config files.\r\nFILES=()\u001b[15X\r\n\u001b[68X\u001b[21;3HHOOKS\u001b[54X\u001b[22;3HThis is the most important setting in this file.  The HOOKS control the  \u001b[23;3Hmodules and scripts added to the image, and what happens at boot time.\u001b[24;2H Order is important, and it is recommended that you do not change the\u001b[25;2H order in which HOOKS are added.  Run 'mkinitcpio -H <hook name>' for\u001b[26;3Hhelp on a given hook.\u001b[27;2H 'base' is _required_ unless you know precisely what you are doing.\u001b[28;2H 'udev' is _required_ in order to automatically load modules\u001b[9X\u001b[29;2H 'filesystems' is _required_ unless you specify your fs modules in MODULES\u001b[30;3HExamples:\u001b[63X\u001b[31;2H#   This setup specifies all modules in the MODULES setting above.\u001b[32;6HNo RAID, lvm2, or encrypted root is needed.\u001b[25X\u001b[33;2H    HOOKS=(base)\u001b[13X\u001b[34;2H\u001b[62X\n#   This setup will autodetect all modules for your system and should\u001b[36;6Hwork as a sane default\u001b[48X\u001b[37;2H    HOOKS=(base udev autodetect microcode modconf block filesystems fsck)\u001b[5X\u001b[38;2H\u001b[109X\n#   This setup will generate a 'full' image which supports most systems.\u001b[40;6HNo autodetection is done.\u001b[13X\u001b[41;47Hfilesystems fsck)\u001b[5X\u001b[43;11Hsetup assembles a mdadm array with an encrypted root file system.\u001b[14X\u001b[44;2H#   Note: See 'mkinitcpio -H mdadm_udev' for more information on RAID devices.\u001b[34X\u001b[45;2H    HOOKS=(base udev microcode modconf keyboard keymap consolefont block mdadm_udev encrypt filesystems fsck)\u001b[46;2H\u001b[72X\n#   This setup loads an lvm2 volume group.\r\n#    HOOKS=(base udev microcode modconf block lvm2 filesystems fsck)\u001b[45X\r\n#\n#   This will create a systemd based initramfs which loads an encrypted root filesystem.\u001b[51;3H   HOOKS=(base systemd autodetect microcode modconf kms keyboard sd-vconsole block sd-encrypt filesystems fsck)\u001b[52;2H\u001b[70X\n#   NOTE: If you have /usr on a separate partition, you MUST include the\u001b[54;2H    usr and fsck hooks.\r\nHOOKS=(base systemd autodetect microcode modconf kms keyboard sd-vconsole block sd-encrypt lvm2 filesystems fsck)\r\n\u001b[20X\u001b[57;2H COMPRESSION\u001b[6X\r\n# Use this to compress the initramfs image. By default, zstd compression\u001b[K\r\n# is used for Linux ≥\u001b[59;22H 5.9 and gzip compression is used for Linux < 5.9.\r\n# Use 'cat' to create an uncompressed image.\r\n#COMPRESSION=\"zstd\"\r\n#COMPRESSION=\"gzip\"\u001b[K\r\n#COMPRESSION=\"bzip2\"\u001b[K\r\n#COMPRESSION=\"lzma\"\u001b[K\r\n#COMPRESSION=\"xz\"\u001b[K\r\n\u001b[0;10;7m\u000fetc/mkinitcpio.conf [+]                                                                                                                                                                                                       55,92          Top\u001b[2 q\u001b[?1002h\u001b[?1006h\u001b[55;92H\u001b[?25h"]
