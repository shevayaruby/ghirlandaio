[0.015, "o", "==> Creating install root at /mnt\r\n"]
[0.034, "o", "==> Installing packages to /mnt\r\n"]
[0.012, "o", "\u001b[?25l\u001b[1;34m::\u001b[0;1m Synchronizing package databases...\r\n\u001b[0m"]
[0.000, "o", " core\r\n extra\r\n"]
