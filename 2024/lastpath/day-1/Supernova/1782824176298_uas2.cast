[0.006, "o", "Running in a chroot, enabling --graceful.\r\r\n"]
[0.001, "o", "Created directory \"/boot/EFI\".\r\r\nCreated directory \"/boot/EFI/systemd\".\r\r\nCreated directory \"/boot/EFI/BOOT\".\r\r\nCreated directory \"/boot/loader\".\r\r\nCreated directory \"/boot/loader/keys\".\r\r\nCreated directory \"/boot/loader\".\r\r\nCreated directory \"/boot/loader/entries\".\r\r\nCreated directory \"/boot/EFI\".\r\r\n"]
[0.000, "o", "Created directory \"/boot/EFI/Linux\".\r\r\n"]
[0.032, "o", "Copied \"/usr/lib/systemd/boot/efi/systemd-bootx64.efi\" to \"/boot/EFI/systemd/systemd-bootx64.efi\".\r\r\n"]
[0.005, "o", "Copied \"/usr/lib/systemd/boot/efi/systemd-bootx64.efi\" to \"/boot/EFI/BOOT/BOOTX64.EFI\".\r\r\n"]
[0.003, "o", " Mount point '/boot' which backs the random seed file is world accessible, which is a security hole! \r\r\nRandom seed file '/boot/loader/.#bootctlrandom-seed88d1066e9f060086' is world accessible, which is a security hole!\r\r\n"]
[0.003, "o", "Random seed file /boot/loader/random-seed successfully written (32 bytes).\r\r\nNot booted with EFI or running in a container, skipping EFI variable modifications.\r\r\n"]
